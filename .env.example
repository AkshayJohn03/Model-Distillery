# Teacher endpoint: any OpenAI-compatible server (vLLM, Ollama, OpenAI, ...).
DISTILLERY_TEACHER_BASE_URL=http://localhost:8000/v1
DISTILLERY_TEACHER_API_KEY=sk-local
DISTILLERY_TEACHER_MODEL=Qwen/Qwen2.5-32B-Instruct

# Student endpoint used by the bench step (falls back to teacher settings when unset).
DISTILLERY_STUDENT_BASE_URL=http://localhost:8001/v1
DISTILLERY_STUDENT_API_KEY=sk-local
DISTILLERY_STUDENT_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Client behaviour
DISTILLERY_REQUEST_TIMEOUT=60
DISTILLERY_CONCURRENCY=8
